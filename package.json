{
  "name": "@comput/pi-background",
  "version": "0.1.0",
  "description": "Start one-shot background Pi subagents with durable task tracking and parent-owned follow-up.",
  "license": "MIT",
  "author": "Martin Bundgaard",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "background",
    "subagents",
    "coding-agent"
  ],
  "homepage": "https://github.com/mbundgaard/PiBackground#readme",
  "bugs": {
    "url": "https://github.com/mbundgaard/PiBackground/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbundgaard/PiBackground.git"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:smoke",
    "test:smoke": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
